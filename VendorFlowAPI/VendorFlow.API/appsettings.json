{
  "ConnectionStrings": {
    "VendorFlow": "Host=localhost;Port=5432;Database=Vendor_db;Username=postgres"
  },
  "Jwt": { "Issuer": "VendorFlow", "Audience": "VendorFlowClients" },
  "Database": { "AutoMigrate": true },
  "Storage": { "Path": "storage" },
  "Cors": { "Origins": "http://localhost:4200" },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "Microsoft.AspNetCore": "Warning", "System": "Warning" }
    }
  },
  "AllowedHosts": "*"
}
